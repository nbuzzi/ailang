# Example 05 — First-Class Code Generation and Surgical Editing
# ailang enables AI agents to generate and surgically edit source files
# with zero boilerplate, fuzzy whitespace tolerance, and minimal token cost.

# 1. Generate a source file using multiline triple-quoted string
"""
function calculateTotal(price, taxRate) {
    let subtotal = price;
    let tax = price * taxRate;
    return subtotal + tax;
}
""" > temp_calc.js;

# 2. Surgically replace a function parameter & logic
replace temp_calc.js "let subtotal = price;" "let subtotal = price - (price * discount);";
replace temp_calc.js "price, taxRate" "price, taxRate, discount = 0";

# 3. Insert logging or instrumentation around code anchors
insert_after temp_calc.js "let subtotal" "    console.log('Calculating discount...');";
insert_before temp_calc.js "return" "    // Prepare final total with tax applied";

# 4. Prepend file headers, licensing, or imports
prepend temp_calc.js "// @license MIT - Generated by ailang agent";

# 5. Append module exports or test cases
append temp_calc.js "module.exports = { calculateTotal };";

# 6. View the updated file
< temp_calc.js;
